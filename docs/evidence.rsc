1:[["$","section",null,{"className":"intro","children":[["$","div",null,{"className":"eyebrow","children":"METHODOLOGY / EVIDENCE"}],["$","h1",null,{"children":"A conclusion you can trace back to the test."}],["$","div",null,{"className":"lead","children":["$","p",null,{"children":"RiskStriker’s planned evidence pack brings the system, risk definition, scenarios and measured consequences into one reviewable record."}]}]]}],["$","section",null,{"className":"section","children":["$","div",null,{"className":"grid3","children":[["$","article","System & configuration",{"children":[["$","h3",null,{"children":"System & configuration"}],["$","p",null,{"children":"Agent version, permissions, autonomy, controls, configuration fingerprint and test date."}]]}],["$","article","Risk & coverage",{"children":[["$","h3",null,{"children":"Risk & coverage"}],["$","p",null,{"children":"Risk tolerance, red lines, tested and partially tested areas, plus what was not tested or not observable."}]]}],["$","article","Environment",{"children":[["$","h3",null,{"children":"Environment"}],["$","p",null,{"children":"Identify real, test-equivalent, simulated and out-of-scope components. Do not hide simulation."}]]}],["$","article","Observed impact",{"children":[["$","h3",null,{"children":"Observed impact"}],["$","p",null,{"children":"Attempted and realised actions, trial counts, maximum observed impact, containment and recovery."}]]}],["$","article","Control verification",{"children":[["$","h3",null,{"children":"Control verification"}],["$","p",null,{"children":"Link baseline, customer remediation and the same-scenario retest. Report the measured difference."}]]}],["$","article","Remaining uncertainty",{"children":[["$","h3",null,{"children":"Remaining uncertainty"}],["$","p",null,{"children":"Record unresolved failures, inconclusive results, assumptions and limitations alongside the conclusion."}]]}]]}]}],["$","aside",null,{"className":"boundary","children":[["$","div",null,{"className":"eyebrow","children":"WHAT THE EVIDENCE DOES NOT SAY"}],["$","h2",null,{"children":"Tested does not mean universally safe."}],["$","p",null,{"children":"An assessment does not certify an agent or guarantee future behaviour. Coverage, unresolved failures, inconclusive results and simulated components remain part of the conclusion. Risk acceptance stays with the customer."}],["$","p",null,{"className":"small","children":"Initial scope excludes production runtime defence, a kill switch and automatic remediation."}]]}]]
