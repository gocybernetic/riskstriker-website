1:[["$","section",null,{"className":"intro","children":[["$","div",null,{"className":"eyebrow","children":"THE EVIDENCE APPROACH"}],["$","h1",null,{"children":"Show the result. Keep the context."}],["$","div",null,{"className":"lead","children":["$","p",null,{"children":"The planned RiskStriker evidence pack connects each conclusion to the system and scenarios tested."}]}]]}],["$","section",null,{"className":"section","children":["$","div",null,{"className":"evidence-grid","children":[["$","article","01 / System",{"children":[["$","h3",null,{"children":"01 / System"}],["$","p",null,{"children":"Agent version, tools, permissions, autonomy, control configuration and assessment date."}]]}],["$","article","02 / Risk boundaries",{"children":[["$","h3",null,{"children":"02 / Risk boundaries"}],["$","p",null,{"children":"The organisation’s risk tolerance, red lines and required failure behaviour."}]]}],["$","article","03 / Environment",{"children":[["$","h3",null,{"children":"03 / Environment"}],["$","p",null,{"children":"Which components were real, test-equivalent, simulated or outside scope."}]]}],["$","article","04 / Coverage",{"children":[["$","h3",null,{"children":"04 / Coverage"}],["$","p",null,{"children":"Tested, partially tested, not tested and not observable areas. Scenario quantity alone does not establish assurance quality."}]]}],["$","article","05 / Consequence",{"children":[["$","h3",null,{"children":"05 / Consequence"}],["$","p",null,{"children":"Attempted and realised actions, trial counts, maximum observed impact, containment and recovery."}]]}],["$","article","06 / Control verification",{"children":[["$","h3",null,{"children":"06 / Control verification"}],["$","p",null,{"children":"The baseline, customer control change, identical-scenario retest and measured difference."}]]}],["$","article","07 / Residual uncertainty",{"children":[["$","h3",null,{"children":"07 / Residual uncertainty"}],["$","p",null,{"children":"Unresolved failures, inconclusive results, assumptions and limitations."}]]}],["$","article","08 / Tested conditions",{"children":[["$","h3",null,{"children":"08 / Tested conditions"}],["$","p",null,{"children":"A bounded conclusion for the configuration and scenarios assessed, ready for the organisation’s risk review."}]]}]]}]}],["$","aside",null,{"className":"boundary","children":[["$","div",null,{"className":"eyebrow","children":"THE LIMIT OF THE CLAIM"}],["$","h2",null,{"children":"A test result is evidence. It is not a guarantee."}],["$","p",null,{"children":"Results apply to the configuration, environment and scenarios assessed. Untested areas, unresolved failures and inconclusive results belong in the conclusion. The organisation remains responsible for risk acceptance."}],["$","p",null,{"children":"RiskStriker is in development. Initial scope excludes production runtime defence, automatic remediation and certification."}]]}]]
