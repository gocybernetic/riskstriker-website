e:["$","aside",null,{"className":"boundary","children":[["$","div",null,{"className":"eyebrow","children":"WHAT THE EVIDENCE DOES NOT SAY"}],["$","h2",null,{"children":"Tested does not mean universally safe."}],["$","p",null,{"children":"An assessment does not certify an agent or guarantee future behaviour. Coverage, unresolved failures, inconclusive results and simulated components remain part of the conclusion. Risk acceptance stays with the customer."}],["$","p",null,{"className":"small","children":"Initial scope excludes production runtime defence, a kill switch and automatic remediation."}]]}]
