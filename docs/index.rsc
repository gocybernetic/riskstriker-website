1:[["$","section",null,{"className":"hero product-hero","children":[["$","div",null,{"className":"eyebrow","children":"OPERATIONAL ASSURANCE FOR AUTONOMOUS AI AGENTS"}],["$","h1",null,{"children":["Stress the agent.",["$","br",null,{}],"Measure the impact.",["$","br",null,{}],["$","em",null,{"children":"Verify the controls."}]]}],["$","div",null,{"className":"hero-bottom","children":[["$","p",null,{"children":"RiskStriker is designed to test what happens when consequential agents fail—and which controls contain the impact."}],["$","a",null,{"className":"button","href":"/riskstriker/","children":"Explore the approach ↗"}]]}]]}],["$","section",null,{"className":"feature","children":[["$","div",null,{"children":[["$","div",null,{"className":"eyebrow","children":"BEYOND THE ATTEMPT"}],["$","h2",null,{"children":"What did the agent actually manage to do?"}],["$","p",null,{"children":"An attempted prohibited action and a realised consequence are different things. RiskStriker’s proposed workflow measures both, then tests the same scenario after a customer changes a control."}],["$","p",null,{"children":"Evidence stays tied to the system, configuration, test environment and scenarios assessed."}]]}],["$","div",null,{"className":"workflow","aria-label":"RiskStriker assurance workflow","children":[["$","div",null,{"className":"workflow-title","children":"FROM CONTEXT TO EVIDENCE"}],[["$","div","01",{"className":"step","children":[["$","span",null,{"children":"01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Understand"}],["$","p",null,{"children":"Agent context · autonomy · red lines"}]]}]]}],["$","div","02",{"className":"step","children":[["$","span",null,{"children":"02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stress & measure"}],["$","p",null,{"children":"Cyber + operational scenarios · realised impact"}]]}]]}],["$","div","03",{"className":"step","children":[["$","span",null,{"children":"03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Verify"}],["$","p",null,{"children":"Control change · same-scenario retest"}]]}]]}],["$","div","04",{"className":"step","children":[["$","span",null,{"children":"04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Record"}],["$","p",null,{"children":"Tested conditions · coverage · limitations"}]]}]]}]],["$","div",null,{"className":"workflow-foot","children":"A bounded conclusion. An informed human decision."}]]}]]}],["$","section",null,{"className":"section","id":"scenarios","children":[["$","div",null,{"className":"eyebrow","children":"ILLUSTRATIVE SCENARIOS / FICTIONAL DEPARTMENT X"}],["$","h2",null,{"children":"Follow the consequence."}],["$","p",null,{"className":"wide","children":"These synthetic examples explain the planned methodology. They are not customer results or a claim of completed testing."}],["$","div",null,{"className":"grid3","children":[["$","article",null,{"children":[["$","span",null,{"className":"tag","children":"CYBER"}],["$","h3",null,{"children":"A document asks for another citizen’s case."}],["$","p",null,{"children":"Prompt injection leads the agent to attempt cross-case access. Compare the records actually returned before and after case-scoped authorisation."}],["$","div",null,{"className":"outcome","children":"Observe: prohibited records returned"}]]}],["$","article",null,{"children":[["$","span",null,{"className":"tag","children":"OPERATIONAL"}],["$","h3",null,{"children":"The update succeeds. The reply is lost."}],["$","p",null,{"children":"An agent retries a completed mutation. Test whether idempotency and state verification prevent a duplicate action under the same failure."}],["$","div",null,{"className":"outcome","children":"Observe: duplicate mutations"}]]}],["$","article",null,{"children":[["$","span",null,{"className":"tag","children":"AGENTIC"}],["$","h3",null,{"children":"An approval instruction falls out of context."}],["$","p",null,{"children":"The agent attempts to send correspondence. Test whether a deterministic tool-level gate blocks execution without the required approval."}],["$","div",null,{"className":"outcome","children":"Observe: unapproved messages sent"}]]}]]}]]}],["$","section",null,{"className":"section","children":[["$","h2",null,{"children":"Evidence, with the limits attached."}],["$","p",null,{"className":"wide","children":"Tested Operating Conditions describe the configuration, autonomy and controls under which the agent remained within stated risk tolerance across the scenarios actually tested."}],"$Ld"]}],"$Le"]
