1:[["$","section",null,{"className":"intro","children":[["$","div",null,{"className":"eyebrow","children":"RISKSTRIKER / A CYBERNETIC PRODUCT"}],["$","h1",null,{"children":"Stress the agent. Measure the impact. Verify the controls."}],["$","div",null,{"className":"lead","children":["$","p",null,{"children":"Operational assurance for autonomous AI agents. RiskStriker is designed to test the complete agentic system and produce evidence for the organisation’s risk decision."}]}]]}],["$","section",null,{"className":"feature","children":[["$","div",null,{"children":[["$","h2",null,{"children":"Control presence is a starting point."}],["$","p",null,{"children":"The practical question is whether a control contains impact when an agent encounters a severe but plausible failure."}],["$","p",null,{"children":"The proposed workflow brings cyber, operational and agentic scenarios together: from malicious tool output to a lost acknowledgement after a successful action."}],["$","p",null,{"children":"“Independent” refers to verification of the assessed controls. It does not imply independence from Cybernetic Limited or accredited certification."}]]}],["$","div",null,{"className":"workflow","aria-label":"RiskStriker assurance workflow","children":[["$","div",null,{"className":"workflow-title","children":"FROM CONTEXT TO EVIDENCE"}],[["$","div","01",{"className":"step","children":[["$","span",null,{"children":"01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Understand"}],["$","p",null,{"children":"Agent context · autonomy · red lines"}]]}]]}],["$","div","02",{"className":"step","children":[["$","span",null,{"children":"02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stress & measure"}],["$","p",null,{"children":"Cyber + operational scenarios · realised impact"}]]}]]}],["$","div","03",{"className":"step","children":[["$","span",null,{"children":"03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Verify"}],["$","p",null,{"children":"Control change · same-scenario retest"}]]}]]}],["$","div","04",{"className":"step","children":[["$","span",null,{"children":"04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Record"}],["$","p",null,{"children":"Tested conditions · coverage · limitations"}]]}]]}]],["$","div",null,{"className":"workflow-foot","children":"A bounded conclusion. An informed human decision."}]]}]]}],["$","section",null,{"className":"section","id":"scenarios","children":[["$","div",null,{"className":"eyebrow","children":"ILLUSTRATIVE SCENARIOS / FICTIONAL DEPARTMENT X"}],["$","h2",null,{"children":"Follow the consequence."}],["$","p",null,{"className":"wide","children":"These synthetic examples explain the planned methodology. They are not customer results or a claim of completed testing."}],["$","div",null,{"className":"grid3","children":[["$","article",null,{"children":[["$","span",null,{"className":"tag","children":"CYBER"}],["$","h3",null,{"children":"A document asks for another citizen’s case."}],["$","p",null,{"children":"Prompt injection leads the agent to attempt cross-case access. Compare the records actually returned before and after case-scoped authorisation."}],["$","div",null,{"className":"outcome","children":"Observe: prohibited records returned"}]]}],["$","article",null,{"children":[["$","span",null,{"className":"tag","children":"OPERATIONAL"}],["$","h3",null,{"children":"The update succeeds. The reply is lost."}],["$","p",null,{"children":"An agent retries a completed mutation. Test whether idempotency and state verification prevent a duplicate action under the same failure."}],["$","div",null,{"className":"outcome","children":"Observe: duplicate mutations"}]]}],["$","article",null,{"children":[["$","span",null,{"className":"tag","children":"AGENTIC"}],["$","h3",null,{"children":"An approval instruction falls out of context."}],["$","p",null,{"children":"The agent attempts to send correspondence. Test whether a deterministic tool-level gate blocks execution without the required approval."}],["$","div",null,{"className":"outcome","children":"Observe: unapproved messages sent"}]]}]]}]]}],["$","section",null,{"className":"section","children":[["$","div",null,{"className":"eyebrow","children":"THE OUTPUT"}],["$","h2",null,{"children":"Tested Operating Conditions."}],"$Ld","$Le"]}],"$Lf"]
d:["$","p",null,{"className":"wide","children":"A conclusion tied to the specific configuration, autonomy, permissions, human oversight and controls under which the agent stayed within stated risk tolerance across the scenarios actually tested."}]
e:["$","a",null,{"className":"text-link","href":"/evidence/","children":"What belongs in an evidence pack →"}]
f:["$","aside",null,{"className":"boundary","children":[["$","div",null,{"className":"eyebrow","children":"WHAT THE EVIDENCE DOES NOT SAY"}],["$","h2",null,{"children":"Tested does not mean universally safe."}],["$","p",null,{"children":"An assessment does not certify an agent or guarantee future behaviour. Coverage, unresolved failures, inconclusive results and simulated components remain part of the conclusion. Risk acceptance stays with the customer."}],["$","p",null,{"className":"small","children":"Initial scope excludes production runtime defence, a kill switch and automatic remediation."}]]}]
