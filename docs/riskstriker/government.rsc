1:[["$","section",null,{"className":"intro","children":[["$","div",null,{"className":"eyebrow","children":"PUBLIC-SECTOR EVALUATION"}],["$","h1",null,{"children":"Consequential agents need context-specific evidence."}],["$","div",null,{"className":"lead","children":["$","p",null,{"children":"RiskStriker’s initial focus is UK public-sector organisations deploying or preparing action-taking AI agents. The proposed first commercial motion is R&D and design partnership."}]}]]}],["$","section",null,{"className":"section","children":["$","div",null,{"className":"grid3","children":[["$","article",null,{"children":[["$","h3",null,{"children":"For practitioners"}],["$","p",null,{"children":"Reproduce meaningful failures in authorised test environments, measure actual consequences and assess control changes."}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"For security leadership"}],["$","p",null,{"children":"Review which material risks, red-line breaches and control gaps remain unresolved."}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"For governance teams"}],["$","p",null,{"children":"Bring scoped evidence into the existing risk and deployment decision, with coverage and limitations visible."}]]}]]}]}],["$","section",null,{"className":"section","id":"scenarios","children":[["$","div",null,{"className":"eyebrow","children":"ILLUSTRATIVE SCENARIOS / FICTIONAL DEPARTMENT X"}],["$","h2",null,{"children":"Follow the consequence."}],["$","p",null,{"className":"wide","children":"These synthetic examples explain the planned methodology. They are not customer results or a claim of completed testing."}],["$","div",null,{"className":"grid3","children":[["$","article",null,{"children":[["$","span",null,{"className":"tag","children":"CYBER"}],["$","h3",null,{"children":"A document asks for another citizen’s case."}],["$","p",null,{"children":"Prompt injection leads the agent to attempt cross-case access. Compare the records actually returned before and after case-scoped authorisation."}],["$","div",null,{"className":"outcome","children":"Observe: prohibited records returned"}]]}],["$","article",null,{"children":[["$","span",null,{"className":"tag","children":"OPERATIONAL"}],["$","h3",null,{"children":"The update succeeds. The reply is lost."}],["$","p",null,{"children":"An agent retries a completed mutation. Test whether idempotency and state verification prevent a duplicate action under the same failure."}],["$","div",null,{"className":"outcome","children":"Observe: duplicate mutations"}]]}],["$","article",null,{"children":[["$","span",null,{"className":"tag","children":"AGENTIC"}],["$","h3",null,{"children":"An approval instruction falls out of context."}],["$","p",null,{"children":"The agent attempts to send correspondence. Test whether a deterministic tool-level gate blocks execution without the required approval."}],["$","div",null,{"className":"outcome","children":"Observe: unapproved messages sent"}]]}]]}]]}],["$","section",null,{"className":"section","children":[["$","h2",null,{"children":"What to establish before an assessment."}],["$","ol",null,{"className":"reading-list","children":[["$","li",null,{"children":"The agent, use case and actions it can take."}],["$","li",null,{"children":"Your risk tolerance, red lines and required failure behaviour."}],["$","li",null,{"children":"Authorised test targets, synthetic data and environment representation."}],["$","li",null,{"children":"How each material consequence will be observed."}],["$","li",null,{"children":"Who reviews the evidence and accepts residual risk."}]]}],["$","p",null,{"className":"small","children":"These are proposed assessment requirements. This page makes no claim of government endorsement, accreditation, contract award or current pilot deployment."}]]}],["$","aside",null,{"className":"boundary","children":[["$","div",null,{"className":"eyebrow","children":"WHAT THE EVIDENCE DOES NOT SAY"}],["$","h2",null,{"children":"Tested does not mean universally safe."}],["$","p",null,{"children":"An assessment does not certify an agent or guarantee future behaviour. Coverage, unresolved failures, inconclusive results and simulated components remain part of the conclusion. Risk acceptance stays with the customer."}],"$Ld"]}]]
d:["$","p",null,{"className":"small","children":"Initial scope excludes production runtime defence, a kill switch and automatic remediation."}]
