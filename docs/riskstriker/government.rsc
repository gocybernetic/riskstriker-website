1:[["$","section",null,{"className":"intro","children":[["$","div",null,{"className":"eyebrow","children":"PUBLIC-SECTOR EVALUATION"}],["$","h1",null,{"children":"Specific agents. Specific contexts."}],["$","div",null,{"className":"lead","children":["$","p",null,{"children":"Our initial focus is the cybersecurity and operational resilience of action-taking public-sector agents. RiskStriker is at the R&D stage, not in production."}]}]]}],["$","section",null,{"className":"section","children":[["$","div",null,{"className":"section-head","children":[["$","div",null,{"className":"section-label","children":"THE DECISION"}],["$","div",null,{"children":[["$","h2",null,{"children":["What authority?",["$","br",null,{}],"Under which controls?"]}],["$","p",null,{"children":"Useful assurance starts with the deployment decision your organisation needs to make. The proposed method connects that decision to explicit risk boundaries and observable consequences."}]]}]]}],["$","div",null,{"className":"grid3","children":[["$","article",null,{"children":[["$","h3",null,{"children":"Practitioners"}],["$","p",null,{"children":"Reproduce meaningful failures, inspect downstream state and retest the controls after remediation."}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"Security leadership"}],["$","p",null,{"children":"Review material red-line breaches, control gaps and the limits of the evidence."}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"Governance teams"}],["$","p",null,{"children":"Bring a scoped assessment into the existing risk and deployment-approval process."}]]}]]}]]}],["$","section",null,{"className":"editorial","children":[["$","div",null,{"children":["$","h2",null,{"children":["Start with a",["$","br",null,{}],"real decision."]}]}],["$","div",null,{"children":[["$","p",null,{"children":"Identify the agent, its operational owner and the systems it can affect. Define unacceptable outcomes, the authorised test environment, available observations and the person accountable for accepting residual risk."}],["$","a",null,{"className":"link-line","href":"/scenarios/","children":"See the casework examples ↗"}]]}]]}],["$","aside",null,{"className":"boundary","children":[["$","div",null,{"className":"eyebrow","children":"THE LIMIT OF THE CLAIM"}],["$","h2",null,{"children":"A test result is evidence. It is not a guarantee."}],["$","p",null,{"children":"Results apply to the configuration, environment and scenarios assessed. Untested areas, unresolved failures and inconclusive results belong in the conclusion. The organisation remains responsible for risk acceptance."}],["$","p",null,{"children":"RiskStriker is in development. Initial scope excludes production runtime defence, automatic remediation and certification."}]]}]]
