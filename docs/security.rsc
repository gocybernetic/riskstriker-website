1:[["$","section",null,{"className":"intro","children":[["$","div",null,{"className":"eyebrow","children":"SECURITY / DESIGN APPROACH"}],["$","h1",null,{"children":"Make the test boundary explicit."}],["$","div",null,{"className":"lead","children":["$","p",null,{"children":"Security testing starts with authorised targets, a suitable test environment and a clear agreement on what will be observed."}]}]]}],["$","section",null,{"className":"section","children":[["$","div",null,{"className":"grid3","children":[["$","article",null,{"children":[["$","h3",null,{"children":"Scope before execution"}],["$","p",null,{"children":"The planned methodology records the agent, capabilities, required controls, permitted targets and risk boundaries before an assessment."}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"Keep environment differences visible"}],["$","p",null,{"children":"Real, test-equivalent, simulated and out-of-scope components are recorded in the evidence. A synthetic demonstration does not test a production implementation."}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"Review deployment requirements"}],["$","p",null,{"children":"Customer-side execution, isolation, identity, retention, support access and data handling require assessment-specific review before a pilot."}]]}]]}],["$","p",null,{"className":"small","children":"This page describes the product’s design approach. It is not a security certification, compliance attestation or assurance of an already deployed service."}]]}],["$","aside",null,{"className":"boundary","children":[["$","div",null,{"className":"eyebrow","children":"THE LIMIT OF THE CLAIM"}],["$","h2",null,{"children":"A test result is evidence. It is not a guarantee."}],["$","p",null,{"children":"Results apply to the configuration, environment and scenarios assessed. Untested areas, unresolved failures and inconclusive results belong in the conclusion. The organisation remains responsible for risk acceptance."}],["$","p",null,{"children":"RiskStriker is in development. Initial scope excludes production runtime defence, automatic remediation and certification."}]]}]]
